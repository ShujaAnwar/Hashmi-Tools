# ════════════════════════════════════════════════════════
#  AI Shorts Maker Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────
PORT=3001

# ── AI Metadata Generation (Claude API) ─────────────────
# Get your API key at: https://console.anthropic.com/
# Without this, the tool still works but uses template fallback titles/descriptions.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── YouTube Metadata (optional) ──────────────────────────
# Used ONLY to fetch video titles/descriptions via YouTube Data API v3
# for better AI metadata generation. Video files are NEVER downloaded.
# Get your API key at: https://console.cloud.google.com/
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=AIza-your-key-here

# ── File limits ───────────────────────────────────────────
# Maximum video file size in megabytes (default: 500)
MAX_FILE_SIZE_MB=500

# Maximum video duration in seconds (default: 3600 = 60 min)
MAX_VIDEO_DURATION_SECS=3600

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (besides default list)
# Default list already includes: hashmitools.com, hashmitools.vercel.app, localhost:3000
ALLOWED_ORIGINS=https://hashmitools.com,https://hashmitools.vercel.app
